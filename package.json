{
  "name": "mortgagepro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/assert-e2e-test-environment.mjs && playwright test",
    "test:e2e:public": "playwright test --grep @public",
    "test:security": "node scripts/security-check.mjs && npm audit --omit=dev --audit-level=high",
    "test:lighthouse": "node scripts/lighthouse-check.mjs",
    "test:release": "npm run lint && npx tsc --noEmit && npm run test:unit && npm run test:coverage && npm run build && npm run test:lighthouse && npm run test:security",
    "e2e:seed": "node scripts/seed-appwrite-e2e-data.mjs",
    "e2e:cleanup": "node scripts/cleanup-appwrite-e2e-data.mjs",
    "appwrite:setup": "npm run appwrite:tables && npm run appwrite:indexes",
    "appwrite:auth:configure": "node scripts/configure-appwrite-auth-policies.mjs",
    "appwrite:tables": "node scripts/create-appwrite-tables-and-attributes.mjs",
    "appwrite:indexes": "node scripts/create-appwrite-indexes.mjs",
    "appwrite:seed": "node scripts/seed-appwrite-demo-data.mjs",
    "appwrite:seed:showcase": "node scripts/seed-appwrite-showcase-data.mjs",
    "appwrite:permissions:check": "node scripts/manage-appwrite-permissions.mjs --check",
    "appwrite:permissions:apply": "node scripts/manage-appwrite-permissions.mjs --apply",
    "appwrite:isolation:verify": "node scripts/verify-appwrite-isolation.mjs",
    "security:report": "node scripts/security-report.mjs",
    "security:cleanup": "node scripts/security-cleanup.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.11",
    "lucide-react": "^1.23.0",
    "next": "16.2.12",
    "node-appwrite": "^26.2.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
